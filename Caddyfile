{
    admin off
    frankenphp
    order php_server before file_server
}

http://:{$PORT:80} {
    root * /app
    encode zstd br gzip

    # Serve real .php files directly (dbview.php, etc.)
    @phpFiles {
        file
        path *.php
    }
    handle @phpFiles {
        php_server
    }

    # Root / → serve home.html (public landing page)
    @rootExact {
        path /
    }
    handle @rootExact {
        rewrite * /home.html
        file_server
    }

    # /login (bare) → redirect to the unified modern login page
    @loginBare {
        path /login
        method GET
    }
    redir @loginBare /login.html 301

    # Keep old foundations URLs working after content moved under /school.
    @foundationsLegacy {
        path /foundations /foundations/*
    }
    redir @foundationsLegacy /school{uri} 301

    # Make the old school landing URL resolve to the Foundations entry page.
    @schoolLanding {
        path /school /school/ /school/index.html
    }
    redir @schoolLanding /school/foundations/index.html 301

    # API requests should always hit CodeIgniter, never static-file fallback.
    @teacherCurriculum {
        path /api/teacher/curriculum-catalog
    }
    handle @teacherCurriculum {
        rewrite * /api/teacher/curriculum-catalog.php
        php_server
    }

    @apiRoutes {
        path /api/*
    }
    handle @apiRoutes {
        rewrite * /index.php
        php_server
    }

    # Serve real static files and directory indexes directly
    @staticContent {
        file {
            try_files {path} {path}/index.html
        }
    }
    handle @staticContent {
        rewrite * {file_match.relative}
        file_server
    }

    # Everything else → CodeIgniter front controller
    handle {
        rewrite * /index.php
        php_server
    }
}
