{
    admin off
    frankenphp
    order php_server before file_server
}

http://:{$PORT:80} {
    root * /app
    encode zstd br gzip

    # Allow only the explicitly-supported standalone PHP endpoint.
    @teacherAssignManifest {
        path /api/teacher/assign-manifest.php
    }
    handle @teacherAssignManifest {
        php_server
    }

    # Never expose raw PHP utilities or SQL dumps from the public site.
    @blockedSensitive {
        path /dbview.php /admin-db.php /dbdump.php /install-db.php
        path *.sql *.log *.env *.htpasswd
    }
    respond @blockedSensitive 403

    # Block all other direct PHP file requests; app traffic should go through index.php rewrites.
    @blockedPhp {
        path *.php
    }
    respond @blockedPhp 404

    # Root / → serve home.html (public landing page)
    @rootExact {
        path /
    }
    handle @rootExact {
        rewrite * /home.html
        file_server
    }

    # /login (bare) → redirect to the unified modern login page
    @loginBare {
        path /login
        method GET
    }
    redir @loginBare /login.html 301

    @apiRoutes {
        path /api/*
    }
    handle @apiRoutes {
        rewrite * /index.php
        php_server
    }

    # Serve real static files and directory indexes directly
    @staticContent {
        file {
            try_files {path} {path}/index.html
        }
    }
    handle @staticContent {
        rewrite * {file_match.relative}
        file_server
    }

    # Everything else → CodeIgniter front controller
    handle {
        rewrite * /index.php
        php_server
    }
}
