{
    admin off
    frankenphp
    order php_server before file_server
}

http://:{$PORT:80} {
    root * /app
    encode zstd br gzip

    # Serve real .php files directly (dbview.php, etc.)
    @phpFiles {
        file
        path *.php
    }
    handle @phpFiles {
        php_server
    }

    # Root / → serve home.html (public landing page)
    @rootExact {
        path /
    }
    handle @rootExact {
        rewrite * /home.html
        file_server
    }

    # /login (bare) → redirect to the unified modern login page
    @loginBare {
        path /login
        method GET
    }
    redir @loginBare /login.html 301

    # Serve real .html files directly (home.html, login.html, etc.)
    @staticHtml {
        file
        path *.html
    }
    handle @staticHtml {
        file_server
    }

    # Serve real static assets directly
    @assets {
        file
        path *.css *.js *.png *.jpg *.gif *.svg *.ico *.woff *.woff2
    }
    handle @assets {
        file_server
    }

    # Everything else → CodeIgniter front controller
    handle {
        rewrite * /index.php
        php_server
    }
}
